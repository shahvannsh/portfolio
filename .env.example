# Copy these into Vercel > Project > Settings > Environment Variables (never commit real keys).

# "Leave your details" form -> emails you. Free key from https://resend.com
RESEND_API_KEY=
LEAD_TO=shahvannsh@gmail.com

# Optional AI fallback for the chatbot (costs a little per question).
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
# Set to "true" (as a Vercel env var, then redeploy) to let the chatbot use /api/chat when it doesn't know.
VITE_AI_CHAT=false
