# Copy these into Vercel > Project > Settings > Environment Variables (never commit real keys).
# Step-by-step: MESSAGES-SETUP.md

# 1. Email: "Leave your details" messages arrive in your inbox. Free key from https://resend.com
#    (sign up with the same email address you want to receive messages at).
RESEND_API_KEY=
LEAD_TO=shahvannsh@gmail.com

# 2. Tracking + digests: free Upstash Redis via Vercel > Storage / Marketplace (it fills these in for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 3. AI agent: ranks each message (urgent / high / normal / low / spam) and writes the summary. Costs pennies.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-5-5

# 4. WhatsApp alerts for urgent/high messages and digests: pick ONE option.
CALLMEBOT_APIKEY=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_ID=
LEAD_WHATSAPP_TO=918668995892

# 5. Daily summary (cron). Any long random string; Vercel sends it automatically.
CRON_SECRET=

# How "as per traffic" behaves (defaults shown):
IMMEDIATE_MAX=3   # while there are this many messages or fewer in an hour, each is sent at once
DIGEST_BATCH=5    # when this many are waiting (busy hour), send one ranked digest

# Optional AI fallback for the website chatbot (separate from the message agent).
CHAT_MODEL=claude-haiku-5-5
# Set to "true" (as a Vercel env var, then redeploy) to let the chatbot use /api/chat when it doesn't know.
VITE_AI_CHAT=false
